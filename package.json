{
	"name": "duckdb-access",
	"version": "0.1.0",
	"description": "Run raw SQL from .sql files against DuckDB, with named parameters bound by the driver.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"@duckdb/node-api": ">=1.5.5-r.5"
	},
	"devDependencies": {
		"@duckdb/node-api": "1.5.5-r.5",
		"@types/node": "24.19.0",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	},
	"author": "Thomas Kejser <thomas@kejser.org>",
	"license": "MIT"
}
